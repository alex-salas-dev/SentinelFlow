# =========================
# SentinelFlow - .gitignore
# =========================

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Java / Spring Boot
target/
*.class
*.jar
*.war
*.ear
.mvn/timing.properties

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Node / React
node_modules/
dist/
build/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# Eclipse / STS
.project
.classpath
.settings/
.factorypath
.springBeans
.sts4-cache/

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Docker local overrides
compose.override.yaml
docker-compose.override.yml

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~
